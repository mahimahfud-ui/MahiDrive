# Application
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# Dedicated MahiDrive Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Google OAuth — used only by server-side routes
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
GOOGLE_DRIVE_SCOPE_MODE=app-file

# Generate a fresh 32-byte key for each environment:
# openssl rand -base64 32
# Store it in the hosting provider's secret manager, never in Git.
TOKEN_ENCRYPTION_KEY_BASE64=

# Optional first-owner allowlist; do not rely on this alone for authorization.
OWNER_EMAIL_ALLOWLIST=
