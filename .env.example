# Static HTML client configuration is committed in mahidrive-config.js.
# Only publishable Supabase values may be used by browser code.
APP_BASE_URL=https://<your-hosted-mahidrive-origin>
NEXT_PUBLIC_SUPABASE_URL=https://ymfsjqobgefiagenaibi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<copy-from-supabase-dashboard>

# Server-side secrets ONLY. Set these in Supabase Dashboard > Edge Functions > Secrets.
# Never add them to mahidrive-config.js, HTML, client JS, or Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ymfsjqobgefiagenaibi.supabase.co/functions/v1/mahidrive-api/oauth/callback
MAHIDRIVE_OAUTH_STATE_SECRET=
# Must be base64 encoding of exactly 32 random bytes:
# openssl rand -base64 32
MAHIDRIVE_TOKEN_ENCRYPTION_KEY=

# Scope intentionally starts with the non-restricted drive.file scope.
GOOGLE_DRIVE_SCOPE_MODE=drive.file
